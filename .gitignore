# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
!web/app/plugins/chat-engine/
!web/app/plugins/services-page-editor
!web/app/plugins/headless-core/
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/themes/hello-elementor
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Ignore local Elementor theme that is not part of the repo
web/app/themes/hello-elementor/

# Logs
*.log
web/app/logs/

# Dotenv (Bedrock root only; frontend env examples stay in ports-sacco-frontend)
.env
.env.*
!/.env.example

# Composer
/vendor
auth.json

# WP-CLI
wp-cli.local.yml

# Frontend — Vite project is web/frontend/src/ (ports-sacco-frontend).
# Bedrock only ships published SPA at web/frontend/ (index.html, assets/, …).
web/frontend/src/

# Node
node_modules/
npm-debug.log
yarn.lock
package-lock.json
