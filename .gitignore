# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
!web/app/plugins/chat-engine/
!web/app/plugins/services-page-editor
!web/app/plugins/headless-core/
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/themes/hello-elementor
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Ignore local Elementor theme that is not part of the repo
web/app/themes/hello-elementor/

# Logs
*.log
web/app/logs/

# Dotenv (Bedrock root only; frontend env examples stay in ports-sacco-frontend)
.env
.env.*
!/.env.example

# Composer
/vendor
auth.json

# WP-CLI
wp-cli.local.yml

# Frontend — Bedrock ships published SPA only (no src / no npm on server).
# Source + Vite tooling live in the nested ports-sacco-frontend git repo
# under web/frontend/ (manual git there). After npm run build, commit:
#   index.html, favicon.svg, team-bg.*, assets/
web/frontend/src/
web/frontend/scripts/
web/frontend/public/
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.cache/
web/frontend/.vite/
web/frontend/build/
web/frontend/package.json
web/frontend/package-lock.json
web/frontend/vite.config.js
web/frontend/tailwind.config.js
web/frontend/postcss.config.js
web/frontend/root-index.html
web/frontend/LICENSE
web/frontend/vite.svg
web/frontend/.gitignore
web/frontend/.env.example
web/frontend/.env.production.example
web/frontend/.env.staging.example

# Node
node_modules/
npm-debug.log
yarn.lock
package-lock.json
