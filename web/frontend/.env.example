# Copy to .env — Vite loads WP_HOME from Bedrock root .env (../../.env)

# Where the built app is served:
#   /          → http://localhost:4173/membership (dev/preview)
#   /frontend/ → http://ports-sacco/frontend/ (typical WAMP deploy)
VITE_BASE_PATH=/

# Override WordPress URL if needed (default: root WP_HOME)
# VITE_WP_HOME=http://ports-sacco

# Set only if API is on another host (otherwise use Vite proxy / same-origin /wp-json)
# VITE_WP_API_BASE=http://ports-sacco

VITE_WP_FRESH_API=true

# VITE_WP_REST_PATH=/wp-json/chat/v1
# VITE_WHATSAPP_NUMBER=

# Turnstile is configured in WP Admin → Headless Core (off by default).
# No Vite Turnstile key is required.

# WAMP production build example:
#   VITE_BASE_PATH=/frontend/
#   npm run build
