VITE_PUBLIC_URL=https://staging.portsacco.co.ke

# WordPress REST API base URL
VITE_WP_HOME=https://staging.portsacco.co.ke

# WordPress REST API path (works at root level /wp-json/ via .htaccess rewrite)
VITE_WP_REST_PATH=/wp-json/chat/v1

# WhatsApp number for "Continue on WhatsApp" link (no "whatsapp:" prefix)
VITE_WHATSAPP_NUMBER=+14155238886

# Bot protection: Cloudflare Turnstile is configured in WP Admin → Headless Core (off by default).

