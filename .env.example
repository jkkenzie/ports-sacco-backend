DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

# Optional database variables
# DB_HOST='localhost'
# DB_PREFIX='wp_'

WP_ENV='development'
WP_HOME='http://example.com'
WP_SITEURL="${WP_HOME}/wp"

# Document root override (production / cPanel only). Leave unset locally → {project}/web.
# Set this on the server instead of hard-coding paths in config/application.php.
# WEBROOT_DIR='/home/USER/public_html'
# Optional PHP error log path (production often uses public_html/error_log).
# PHP_ERROR_LOG='/home/USER/public_html/error_log'

# Headless frontend (PHP — React uses VITE_* in web/frontend/.env.local)
# CORS: required only when React and /wp-json are different origins in the browser.
# Match the URL users use to open the React app (see web/frontend/.env.example).
# HEADLESS_CORS_ORIGIN='http://localhost:3000'
# HEADLESS_FRONTEND_URL="${WP_HOME}/frontend"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Twilio Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_SECRET=

# Gutenberg REST proxy when Cloudflare WAF blocks /wp-json editor saves (HTML + hex colors).
# Default: admin-ajax → /wp/wp-admin/admin-ajax.php (logged-in only; skips SPA catch-all).
# HEADLESS_ADMIN_REST_PROXY=admin-ajax
# HEADLESS_ADMIN_REST_PROXY=hc-wp-api
# HEADLESS_ADMIN_REST_PROXY=off

# Optional Cloudflare Turnstile (prefer WP Admin → Headless Core; off unless enabled + keys set)
# HEADLESS_TURNSTILE_ENABLED=0
# HEADLESS_TURNSTILE_SITE_KEY=
# HEADLESS_TURNSTILE_SECRET=

# Optional Content-Security-Policy (leave unset until vetted against Turnstile / YouTube / WP admin)
# HEADLESS_CONTENT_SECURITY_POLICY=
# HEADLESS_CONTENT_SECURITY_POLICY_REPORT_ONLY=

# MailHog (WordPress form emails)
# Enabled automatically for WP_ENV=development/staging/local.
# Override explicitly if needed:
# HEADLESS_MAILHOG_ENABLED=true
# HEADLESS_MAILHOG_HOST=127.0.0.1
# HEADLESS_MAILHOG_PORT=1025
# Optional sender override:
# HEADLESS_FORM_FROM_EMAIL=no-reply@example.com
# HEADLESS_FORM_FROM_NAME="Ports SACCO"

# Site mail delivery: use the iYi SMTP Mail plugin (web/app/plugins/iyi-smtp-mail).
# It intercepts all wp_mail() calls (contact form, registration, core WordPress mail)
# and sends via Microsoft Graph. Configure Tenant/Client/From in WP Admin → iYi SMTP Mail.
# Keep Force From enabled so every form uses the Graph mailbox (do not hard-code From in forms).
# Locally, leave iYi disabled (or WP_ENV=development) so MailHog can capture mail instead.
# HEADLESS_FORM_FROM_EMAIL / HEADLESS_FORM_FROM_NAME only apply to local MailHog From.